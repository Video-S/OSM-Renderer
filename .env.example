# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional overrides for the persistent local Overijssel OSM dataset (defaults to data/osm/):
# OVERIJSSEL_DATA_DIR="data/osm"
# OVERIJSSEL_PBF_PATH="data/osm/overijssel-261114.osm.pbf"
# OVERIJSSEL_INDEX_PATH="data/osm/overijssel-261114-8ae28196.sqlite"
# Set DISABLE_OVERIJSSEL_BOOTSTRAP="true" (or OVERIJSSEL_AUTO_BOOTSTRAP="false") to skip automatic download/indexing on server startup/requests:
# DISABLE_OVERIJSSEL_BOOTSTRAP="true"
# Set OVERIJSSEL_ALLOW_CUSTOM_SNAPSHOT="true" only when intentionally installing/indexing a custom non-canonical PBF:
# OVERIJSSEL_ALLOW_CUSTOM_SNAPSHOT="true"

